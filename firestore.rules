rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidUserProfile(data) {
      return data.size() >= 2 &&
             data.uid is string &&
             data.displayName is string &&
             data.displayName.size() > 0 &&
             data.displayName.size() <= 100 &&
             (!('email' in data) || data.email is string) &&
             (!('photoUrl' in data) || data.photoUrl is string) &&
             (!('createdAt' in data) || (data.createdAt is timestamp && data.createdAt <= request.time)) &&
             (!('lastActiveAt' in data) || (data.lastActiveAt is timestamp && data.lastActiveAt <= request.time));
    }

    function isValidChatSession(data, userId) {
      return data.size() >= 3 &&
             data.id is string &&
             data.userId == userId &&
             data.title is string &&
             data.title.size() > 0 &&
             data.title.size() <= 200 &&
             (!('createdAt' in data) || (data.createdAt is timestamp && data.createdAt <= request.time)) &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidChatMessage(data, userId) {
      return data.size() >= 5 &&
             data.id is string &&
             data.sessionId is string &&
             data.userId == userId &&
             data.sender in ['USER', 'RAMSES'] &&
             data.text is string &&
             data.text.size() <= 20000 &&
             (!('timestamp' in data) || (data.timestamp is timestamp && data.timestamp <= request.time)) &&
             (!('isVoiceResponse' in data) || data.isVoiceResponse is bool) &&
             (!('isError' in data) || data.isError is bool);
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidUserProfile(request.resource.data);
      allow delete: if isOwner(userId);

      match /sessions/{sessionId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidChatSession(request.resource.data, userId);
        allow delete: if isOwner(userId);

        match /messages/{messageId} {
          allow read: if isOwner(userId);
          allow create, update: if isOwner(userId) && isValidChatMessage(request.resource.data, userId);
          allow delete: if isOwner(userId);
        }
      }
    }
  }
}
